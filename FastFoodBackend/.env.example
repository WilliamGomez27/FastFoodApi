NODE_ENV=development
PORT=3000

# Clave secreta para JWT (en producción debe tener al menos 32 caracteres y no usar este valor)
JWT_SECRET=change-this-secret-to-something-secure-32chars

JWT_EXPIRES_IN=1h

# Desactivar autenticación durante el desarrollo (solo permitido si NODE_ENV=development o test)
# true: todas las peticiones se autentican automáticamente como admin dev
# false: requiere login y token JWT real
AUTH_DISABLED=false

# Orígenes del frontend separados por comas. En producción se requiere HTTPS.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supermarket_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
